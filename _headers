# Cloudflare Pages response headers (CLAUDE.md §4.6). Not served as a file.
#
# Minified CSS/JS are referenced only with a content-hash ?v= that build.js
# rewrites whenever the file changes (§5.7), so a changed file is a new URL:
# safe to cache for a year without revalidating.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and brand images keep their file names when edited (a re-rotated
# photo overwrites in place), so they get a week, not forever.
/images/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800

# Instagram carousel slides (scripts/ig-slide.sh). Hosted here only so the
# Instagram API can fetch them; kept out of search so they never compete with
# the listing photos they are made from. Never edited in place.
/social/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=604800
